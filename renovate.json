{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>mitodl/.github:renovate-config",
    "customManagers:dockerfileVersions"
  ],
  "gitIgnoredAuthors": [
    "114827586+autofix-ci[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "groupName": "dagster-plugins",
      "matchPackageNames": [
        "dagster{/,}**"
      ]
    },
    {
      "matchDatasources": [
        "python-version"
      ],
      "automerge": false
    },
    {
      "description": "prewarm_uv_cache.sh mirrors the uv commands of the pinned marimo, so a bump needs a look at the build and at first-open time.",
      "matchFileNames": [
        "images/marimo-jupyterlab/**"
      ],
      "automerge": false
    }
  ]
}
