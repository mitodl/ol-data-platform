# Dagster Daemon with ol-orchestrate-lib for pooled Postgres storage
#
# This Dockerfile builds a custom Dagster daemon image that includes
# the ol-orchestrate-lib package, enabling the use of pooled Postgres
# storage classes to prevent connection exhaustion.
#
# Build from repository root:
#   docker build -f dg_deployments/Dockerfile.daemon -t ol-data-platform-daemon:latest .
#
# Usage with Helm chart:
#   Set dagsterDaemon.image.repository and dagsterDaemon.image.tag in values.yaml

FROM python:3.14-slim

# Install uv for faster Python dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Set working directory
WORKDIR /opt/dagster/app

# The path source in dg_deployments/dagster-k8s/pyproject.toml is relative, so
# both trees keep their repository layout under /opt/dagster.
COPY packages/ol-orchestrate-lib /opt/dagster/packages/ol-orchestrate-lib
COPY dg_deployments/dagster-k8s /opt/dagster/dg_deployments/dagster-k8s

# Temporary script for edxorg cleanup
COPY dg_deployments/reconcile_edxorg_partitions.py /opt/dagster/app/reconcile_edxorg_partitions.py

# Install the locked dependency set (dg_deployments/dagster-k8s/uv.lock) into the
# system Python: dagster and its plugins, ol-orchestrate-lib for the pooled Postgres
# storage classes, and the OpenTelemetry agent. --inexact keeps pip and setuptools
# from the base image instead of pruning them. --locked fails the build if the lock
# is out of date rather than resolving fresh, which is how an unlocked install
# picked up SQLAlchemy 2.1 and broke the daemon.
RUN UV_PROJECT_ENVIRONMENT=/usr/local uv sync \
        --project /opt/dagster/dg_deployments/dagster-k8s \
        --locked --inexact

# A stable path to the agent directory, so ol-infrastructure can turn
# instrumentation on with PYTHONPATH without encoding this image's Python
# version. That directory holds a sitecustomize.py, which is the whole of what
# `opentelemetry-instrument` does: it prepends this path and execs the command.
# PYTHONPATH is the only workable lever here because the Dagster Helm chart
# hardcodes `command: ["/bin/bash", "-c", ...]` for both the webserver and the
# daemon, so an ENTRYPOINT would never run.
RUN mkdir -p /opt/otel && \
    ln -s "$(python -c 'import opentelemetry.instrumentation.auto_instrumentation as m, pathlib; print(pathlib.Path(m.__file__).parent)')" \
        /opt/otel/auto_instrumentation
