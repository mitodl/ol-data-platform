---
# Generated from a live Airbyte snapshot by bin/airbyte-inventory.py, then
# resolved by hand. See docs/specs/INGESTION_INVENTORY_SPEC.md §3.
schema_version: 1
deployment: edxorg
layer: TODO_s3
scope: singleton
strategies:
  qa: omit
  local: fixture
loader: airbyte
table_prefix: raw__edxorg__s3__
airbyte:
  source_kind: source-s3
  replication_method: n/a
  connections:
  - name: edx.org Production Course Structure→ S3 Data Lake
    status: active
    sync_interval_hours: 24
    streams:
    - raw__edxorg__s3__course_blocks
  - name: edx.org Tracking Logs → S3 Data Lake
    status: active
    sync_interval_hours: 24
    streams:
    - raw__edxorg__s3__tracking_logs
  - name: S3 edX.org course and program → S3 Data Lake
    status: active
    sync_interval_hours: 24
    streams:
    - raw__edxorg__s3__mitx_course
    - raw__edxorg__s3__mitx_course_run
    - raw__edxorg__s3__program
    - raw__edxorg__s3__program_course
tables:
- name: raw__edxorg__s3__course_blocks
  raw_table: raw__edxorg__s3__course_blocks
  sync_mode: incremental_append
  cursor_field:
  - _ab_source_file_last_modified
  modeled: true
- name: raw__edxorg__s3__mitx_course
  raw_table: raw__edxorg__s3__mitx_course
  sync_mode: incremental_append
  cursor_field:
  - _ab_source_file_last_modified
  modeled: true
- name: raw__edxorg__s3__mitx_course_run
  raw_table: raw__edxorg__s3__mitx_course_run
  sync_mode: incremental_append
  cursor_field:
  - _ab_source_file_last_modified
  modeled: true
- name: raw__edxorg__s3__program
  raw_table: raw__edxorg__s3__program
  sync_mode: incremental_append
  cursor_field:
  - _ab_source_file_last_modified
  modeled: true
- name: raw__edxorg__s3__program_course
  raw_table: raw__edxorg__s3__program_course
  sync_mode: incremental_append
  cursor_field:
  - _ab_source_file_last_modified
  modeled: true
- name: raw__edxorg__s3__tracking_logs
  raw_table: raw__edxorg__s3__tracking_logs
  sync_mode: incremental_append
  cursor_field:
  - _ab_source_file_last_modified
  modeled: true
